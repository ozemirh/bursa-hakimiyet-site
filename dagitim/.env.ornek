# Bursa Hakimiyet — ortam değişkenleri ÖRNEĞİ (değersiz).
#
# Üretimde: /etc/bursahakimiyet/ortam dosyasına kopyalanır, sahibi root,
# izni 0640, grubu uygulama kullanıcısı (bh). systemd birimleri
# `EnvironmentFile=` ile okur. Geliştirmede: depo kökünde `.env` (git'e
# GİRMEZ; `gelistir.ps1` okur).
#
# DEPO HERKESE AÇIK. Bu dosyaya gerçek değer yazılmaz; gerçek değerli dosya
# hiçbir zaman commit edilmez (.gitignore: .env, .env.*).
#
# Zorunlu (üretim): BH_ORTAM, BH_GIZLI_ANAHTAR, BH_SUNUCU_ADLARI.
# Uygulama bunlar olmadan AÇILMAZ (cekirdek/ortam.py, fail-closed).

# --- ortam ve güvenlik ------------------------------------------------------

# gelistirme | test | uretim. Verilmezse "uretim" sayılır.
BH_ORTAM=

# En az 50 karakter, rastgele. Üretmek için:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Değişirse bütün oturumlar düşer (panel kullanıcıları yeniden girer).
# ESKİ, depoda duran "django-insecure-…" anahtarı herkese açık geçmişte
# yazılı: ASLA kullanılmaz.
BH_GIZLI_ANAHTAR=

# Virgüllü konak listesi. Üretimde localhost/127.0.0.1/* KABUL EDİLMEZ.
# Örnek: www.bursahakimiyet.com.tr,bursahakimiyet.com.tr
BH_SUNUCU_ADLARI=

# CSRF güvenilir kökenleri. Boşsa BH_SUNUCU_ADLARI'ndan https://… türetilir.
BH_GUVENILIR_KOKENLER=

# Yalnız geliştirmede anlamlı (1 = DEBUG). Üretimde 1 verilirse uygulama
# açılmaz.
BH_HATA_AYIKLA=

# Üretim: nginx arkasında mı (X-Forwarded-Proto güvenilir)? Varsayılan 1.
BH_VEKIL_ARKASI=
# Üretim: HTTP'den HTTPS'e Django da yönlendirsin mi? Varsayılan 1.
BH_SSL_YONLENDIR=
# HSTS süresi (sn). Varsayılan 86400 (1 gün, kesim günü). Geri dönüş
# penceresi kapanınca 31536000 (1 yıl).
BH_HSTS_SANIYE=
# GERİ ALINMASI ZOR — kullanıcı kararı. Bütün alt alanlar yalnız HTTPS
# olacaksa 1. Alt alanlar (posta, eski panel, reklam) bilinmeden açılmaz.
BH_HSTS_ALT_ALANLAR=
# GERİ ALINMASI ZOR — hstspreload.org listesine girmek için 1.
BH_HSTS_ON_YUKLEME=

# CSP kipi: uygula (varsayılan) | rapor | kapali
BH_CSP=

# /_durum ayrıntısı için dış denetçinin göndereceği X-Durum-Anahtari değeri.
# Boşsa ayrıntıyı yalnız panele girmiş personel görür.
BH_DURUM_ANAHTARI=

# Çalışan sürüm (dağıtım betiği yazar: git rev-parse HEAD). Boşsa .git okunur.
BH_SURUM=

# Başarısız zamanlanmış iş için uyarı adresi (POST). Kanal kullanıcıya
# sorulacak: healthchecks.io /fail adresi, Slack/Telegram webhook, …
BH_UYARI_ADRESI=

# gunicorn işçi sayısı. Boşsa 2 × çekirdek + 1.
BH_ISCI=

# Linux betikleri (dagitim/bin/): kod kökü ve Python.
BH_KOD_KOK=/srv/bursahakimiyet/kod
BH_PYTHON=/srv/bursahakimiyet/venv/bin/python

# --- başarım (paket A) -------------------------------------------------------

# Okur adresi için güvenilir vekiller (adres ya da CIDR, virgüllü).
# ÜRETİMDE ZORUNLU: boşsa X-Forwarded-For hiç okunmaz ve nginx arkasındaki
# BÜTÜN okurlar tek IP (127.0.0.1) sayılır — okunma sayacı ve tekrar
# süzgeci bozulur. nginx aynı makinede, gunicorn 127.0.0.1:8001'de:
#   BH_GUVENILIR_VEKIL=127.0.0.1,::1
# Cloudflare önde ve nginx'teki bh-cloudflare-ip.conf (real_ip) AÇIKSA bu
# yeter: nginx gerçek okur IP'sini zaten çözer. real_ip kapalıysa Cloudflare
# aralıkları da eklenir (snippets/bh-cloudflare-ip.conf'taki liste).
BH_GUVENILIR_VEKIL=
# Paylaşılan önbellek: redis://127.0.0.1:6379/0 (redis paketi ister).
# Boşsa dosya önbelleği BH_ONBELLEK_KOK altında.
BH_REDIS=
# Örnek: /srv/bursahakimiyet/onbellek (bh yazabilmeli)
BH_ONBELLEK_KOK=
# Uygulama içi anonim sayfa önbelleği (sn). 0 = kapalı. Varsayılan 30.
BH_SAYFA_ONBELLEK=
# Veritabanı bağlantı ömrü (sn). Varsayılan 60.
BH_BAGLANTI_OMRU=
# Yavaş sorgu eşiği (ms, varsayılan 200) ve günlük dosyası (boşsa journald).
BH_YAVAS_SORGU_MS=
BH_YAVAS_SORGU_DOSYASI=
# Okunma sayacı yazımı: istek (varsayılan) | komut. "komut" seçilirse
# istek yalnız kuyruğa yazar, veritabanına bh-okunma-bosalt.timer taşır.
BH_OKUNMA_YAZIM=
# Okunma kuyruğu klasörü (varsayılan BH_ONBELLEK_KOK/okunma-kuyrugu).
BH_OKUNMA_KUYRUK=

# --- veritabanı -------------------------------------------------------------

# PostgreSQL: postgresql://bh:PAROLA@127.0.0.1:5432/bursahakimiyet
# Verilirse SQLite yok sayılır.
BH_VERITABANI=
# SQLite dosyası (yalnız geliştirme / göç öncesi). Salt okunur:
# file:/yol/db.sqlite3?mode=ro
BH_SQLITE_YOLU=

# --- dosya kökleri ----------------------------------------------------------

# Arşiv görselleri kökü (altında gorseller/). nginx /arsiv-gorsel/'ü
# buradan doğrudan verir. Örnek: /srv/bursahakimiyet/arsiv
BH_ARSIV_KOK=
# Görsel türevleri kökü (paket D; /gorsel/<genişlik>/… ve /gorsel/og/…).
# Boşsa BH_ARSIV_KOK/turev. nginx'teki `root` ile AYNI olmalı.
# Yeniden üretilebilir; yedek kapsamı dışında. Örnek: /srv/bursahakimiyet/turev
BH_TUREV_KOK=
# collectstatic hedefi (STATIC_ROOT). Örnek: /srv/bursahakimiyet/statik
BH_STATIK_KOK=
# Canlı veri: site OKUR (BH_CANLI_VERI_KOK), betikler YAZAR (BH_CANLI_KOK).
# İkisi aynı klasör olmalı. Örnek: /srv/bursahakimiyet/canli-veri
BH_CANLI_VERI_KOK=
BH_CANLI_KOK=
# site_haritasi_uret çıktısı; nginx /static/sitemap/'i buradan verir.
# Örnek: /srv/bursahakimiyet/sitemap
BH_SITE_HARITASI_KOK=
# /static/sitemap/ Django tarafında da dosyadan verilsin mi? Üretimde
# varsayılan 1 (nginx önce dener, yoksa Django).
BH_SITE_HARITASI_DOSYADAN=

# --- site / besleme ---------------------------------------------------------

# Kanonik kök; sitemap, RSS ve mutlak adresler bundan kurulur.
BH_SITE_KOKU=https://www.bursahakimiyet.com.tr
BH_YAYIN_ADI=
BH_YAYIN_DILI=
BH_RSS_BASLIK=
BH_RSS_ACIKLAMA=
BH_RSS_ADET=
# 0 = beslemede yalnız spot.
BH_RSS_TAM_METIN=

# --- reklam -----------------------------------------------------------------

# Google demo ağı (sunum). 1 açılırsa CSP Google reklam kökenlerine izin
# verir ve sayfa dışarıya istek atar (KVKK çerez aydınlatması gerekir).
BH_REKLAM_DEMO=
BH_REKLAM_YOLU=
# Yerel test reklam hizmeti (yalnız sunum oturumu). Üretimde 0 önerilir.
BH_REKLAM_TEST=0
# AdSense (gazetenin kendi kimliği). Boşsa hiçbir şey basılmaz.
BH_ADSENSE_ID=
BH_ADSENSE_TEST=
BH_ADSENSE_SLOT=
# JSON: {"Manşet yanı": "1234567890"}
BH_ADSENSE_YUVALAR=

# --- sosyal medya -----------------------------------------------------------

# Desen: BH_SOSYAL_<PLATFORM>_<ALAN>, ör. BH_SOSYAL_X_ERISIM_JETONU.
# Ortamdaki değer veritabanındaki kayıttan önce gelir (sosyal/models.py).
# BH_SOSYAL_X_ERISIM_JETONU=
