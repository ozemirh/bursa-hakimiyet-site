# /etc/systemd/system/bh-okunma-bosalt.timer — dakikada bir okunma boşaltma.
# Persistent=true. YALNIZ DOSYA; açmak kullanıcı kararı.

[Unit]
Description=Bursa Hakimiyet okunma kuyrugu (1 dk)

[Timer]
OnCalendar=*:*:00
Persistent=true
AccuracySec=5s
Unit=bh-okunma-bosalt.service

[Install]
WantedBy=timers.target
